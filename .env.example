# --- Supabase / Lovable Cloud (auto-managed) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Paddle (payments) ---
# Client-side token — safe to ship in the browser bundle.
#   .env.development → test_...  (sandbox)
#   .env.production  → live_...  (live)
VITE_PAYMENTS_CLIENT_TOKEN=

# Server-side (managed by Lovable secrets; never hardcode):
#   PADDLE_SANDBOX_API_KEY
#   PADDLE_LIVE_API_KEY
#   PAYMENTS_SANDBOX_WEBHOOK_SECRET
#   PAYMENTS_LIVE_WEBHOOK_SECRET
#   LOVABLE_API_KEY

# --- Field-level encryption ---
FIELD_ENCRYPTION_KEY=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Google OAuth (calendar sync) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional: Sentry ---
VITE_SENTRY_DSN=
